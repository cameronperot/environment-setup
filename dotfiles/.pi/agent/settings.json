{
  "defaultProvider": "openrouter",
  "defaultModel": "z-ai/glm-5.3-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "**/deepseek-v4-*",
    "**/kimi-k3",
    "**/glm-5.3*",
    "**/gpt-5.6-@(luna|sol|terra)",
    "**/gemini-3.7-flash",
    "**/claude-opus-5"
  ],
  "showCacheMissNotices": true,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls",
    "todo",
    "questionnaire",
    "subagent"
  ],
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-rewind@0.5.0"
  ],
  "enableInstallTelemetry": false,
  "theme": "onedark",
  "editorPaddingX": 0,
  "outputPad": 0,
  "doubleEscapeAction": "rewind",
  "branchSummary": {
    "skipPrompt": true
  },
  "lastChangelogVersion": "0.84.3",
  "hideThinkingBlock": false
}
