{
  // ── Bar ──
  "layer": "top",
  "position": "bottom",
  "height": 26,
  "spacing": 0,

  // ── Module layout ──
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad"
  ],
  "modules-center": [],
  "modules-right": [
    "network",
    "custom/tailscale",
    "cpu",
    "temperature",
    "memory",
    "battery",
    "custom/caffeine",
    "clock#berlin",
    "backlight",
    "pulseaudio#output",
    "pulseaudio#input",
    "tray"
  ],

  // ── Sway ──
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "sway/scratchpad": {
    "format": "   {count} ",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  // ── Network & VPN ──
  "network": {
    "interface": "wlp1s0",
    "interval": 10,
    "format": " ↓{bandwidthDownBytes} ↑{bandwidthUpBytes} ",
    "format-disconnected": " Disconnected ",
    "on-click": "kitty -e nmtui",
    "on-click-right": "kitty -e ping -c 3 1.1.1.1"
  },

  "custom/tailscale": {
    "interval": 10,
    "return-type": "json",
    "exec": "if ip a show tailscale0 up >/dev/null 2>&1; then echo '{\"text\": \"ts\", \"class\": \"good\", \"tooltip\": \"Tailscale: Connected\"}'; else echo '{\"text\": \"ts\", \"class\": \"critical\", \"tooltip\": \"Tailscale: Disconnected\"}'; fi"
  },

  // ── System ──
  "cpu": {
    "interval": 10,
    "format": "  {usage}% ",
    "states": {
      "warning": 50,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },

  "temperature": {
    "interval": 10,
    "hwmon-by-name": "k10temp",
    "input-filename": "temp1_input",
    "format": "  {temperatureC}°C ",
    "states": {
      "warning": 60,
      "critical": 80
    },
    "on-click": "kitty -e watch -n 1 sensors"
  },

  "memory": {
    "interval": 10,
    "format": "  {percentage}% ",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },

  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": " {icon} {capacity}% {time} ",
    "format-charging": "  {capacity}% {time} ",
    "format-plugged": "  ",
    "format-full": " {icon} ",
    "format-icons": ["", "", "", "", ""],
    "full-at": 98,
    "on-click": "xfce4-power-manager-settings"
  },

  // ── Caffeine (idle/sleep inhibitor) ──
  "custom/caffeine": {
    "return-type": "json",
    "exec": "~/.config/waybar/caffeine.sh status",
    "on-click": "~/.config/waybar/caffeine.sh toggle",
    "signal": 8,
    "tooltip": true
  },

  // ── Clocks ──
  "clock#berlin": {
    "interval": 10,
    "timezone": "Europe/Berlin",
    "format": " {:%a %m-%d %H:%M:%S %Z} ",
    "tooltip-format": "{:%A, %d %B %Y %Z}\\n{calendar}",
    "today-format": "<b><u>{}</u></b>",
    "on-click": "zenity --calendar"
  },

  // ── Audio & display ──
  "backlight": {
    "device": "intel_backlight",
    "format": " ☀ {percent}% "
  },

  "pulseaudio#output": {
    "format": " {icon} {volume}% ",
    "format-muted": " × ",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "pulseaudio#input": {
    "format": " {format_source} ",
    "format-source": "  ",
    "format-source-muted": "   ",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },

  // ── Tray ──
  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
